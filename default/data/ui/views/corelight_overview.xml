<form version="1.1" script="js/tabs.js" stylesheet="tabs.css">
  <label>Sensor Overview</label>
  <search id="bro_base">
    <query>`corelight_idx` sensor_name="$sensor_name$" `corelight_overview_timechart_bro` </query>
    <earliest>$time_restriction.earliest$</earliest>
    <latest>$time_restriction.latest$</latest>
  </search>
  <search id="iface_base">
    <query>`corelight_idx` sensor_name="$sensor_name$" `corelight_overview_timechart_iface` </query>
    <earliest>$time_restriction.earliest$</earliest>
    <latest>$time_restriction.latest$</latest>
  </search>
  <search id="system_base">
    <query>`corelight_idx` sensor_name="$sensor_name$" `corelight_overview_timechart_system` </query>
    <earliest>$time_restriction.earliest$</earliest>
    <latest>$time_restriction.latest$</latest>
  </search>
  <search id="conn_search">
    <earliest>$time_restriction.earliest$</earliest>
    <latest>$time_restriction.latest$</latest>
    <query>
      `corelight_idx` `corelight_evt_conn` | fields orig_pkts, resp_pkts, service, history, id.resp_p, proto, local_orig, local_resp, missed_bytes, resp_ip_bytes, orig_ip_bytes, duration
    </query>

  </search>
  <fieldset submitButton="false">
    <input type="time" token="time_restriction">
      <label>Time Restriction</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="sensor_name">
      <label>Corelight Sensor</label>
      <fieldForLabel>sensor_name</fieldForLabel>
      <fieldForValue>sensor_name</fieldForValue>
      <selectFirstChoice>true</selectFirstChoice>
      <default>*</default>
      <initialValue>*</initialValue>
      <choice value="*">All</choice>
      <search>
        <query>`corelight_idx` `corelight_evt_metric_system`  | stats count by sensor_name</query>
        <earliest>$time_restriction.earliest$</earliest>
        <latest>$time_restriction.latest$</latest>
      </search>
    </input>
  </fieldset>
  <row>
    <panel><html><h1>Note:</h1> <blockquote>
      If the overview dashboard and its panels are not showing data, please make sure you have configured your Corelight Sensors to export statistics to Splunk. More Information can be found here: <a href="https://www.corelight.com/support" target="_blank">Corelight Support</a> .
    </blockquote></html></panel>
  </row>
  <row id="tabs">
    <panel>
      <html>
        <div class="tab_root" data-id="corelight_sensor_health"
             data-tabs="Rates,System,Data Hygiene"/>
      </html>
    </panel>
  </row>
  <row depends="$hide$">
    <panel>
      <html>
        <style>
          #tab_data_hygiene_row1.dashboard-row.dashboard-layout-rowcolumn-row {
          border-bottom: solid 1px !important;
          border-color: #c9c9c9 !important;
          }
          #tab_data_hygiene_row2.dashboard-row.dashboard-layout-rowcolumn-row {
          border-bottom: solid 1px !important;
          border-color: #c9c9c9 !important;
          }
          #tab_data_hygiene_row3.dashboard-row.dashboard-layout-rowcolumn-row {
          border-bottom: solid 1px !important;
          border-color: #c9c9c9 !important;
          }
        </style>
      </html>
    </panel>
  </row>
  <row id="tab_rates_row1">
